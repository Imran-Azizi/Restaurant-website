# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://zaitoon.example

# Contact placeholders — replace with verified details before launch
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Digits with country code, no + or spaces (e.g. 93700000000)

# Optional map embeds (leave empty until coordinates confirmed)
NEXT_PUBLIC_MAP_EMBED_URL=
NEXT_PUBLIC_MAP_LINK_URL=

# Optional social
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Server-only webhooks (required for real form/order success without WhatsApp)
CONTACT_WEBHOOK_URL=
ORDER_WEBHOOK_URL=

# Optional server-side WhatsApp number alias
WHATSAPP_NUMBER=
